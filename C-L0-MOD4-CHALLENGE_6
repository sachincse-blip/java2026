public class Solution {

public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    long a = sc.nextLong();
    long rev = 0,rem;
    while(a!=0){
        rem = a%10;
        rev = rev*10+rem;
        a = a/10;
    }
    System.out.print(rev);
}
}

